{
  "name": "tg3d-livescores",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@tg3d/web",
    "dev:server": "npm run dev --workspace=@tg3d/server",
    "build": "npm run build --workspace=@tg3d/web && npm run build --workspace=@tg3d/server",
    "start": "npm run start --workspace=@tg3d/server",
    "mobile:sync": "npm run cap:sync --workspace=@tg3d/web",
    "mobile:android": "npm run cap:android --workspace=@tg3d/web",
    "mobile:ios": "npm run cap:ios --workspace=@tg3d/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
